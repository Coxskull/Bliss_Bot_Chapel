# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS financial-ui
WORKDIR /src/bliss-frontend
COPY bliss-frontend/package.json bliss-frontend/package-lock.json ./
RUN npm ci --ignore-scripts --strict-ssl=true
COPY bliss-frontend/ ./
RUN npm test && npm run build

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
COPY --from=financial-ui /src/frontend/operations/financial-review/ ./frontend/operations/financial-review/
RUN dotnet publish Bliss.Api/Bliss.Api.csproj -c Release -o /app/publish /p:UseAppHost=false \
    && test -s /app/publish/frontend/operations/financial-review/index.html

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-cache policy perl-base \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core perl-base openssl util-linux \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.36.0-7+deb12u4' \
    && dpkg-query -W -f='perl-base installed: ${Version}\n' perl-base \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
# Private fixed-fixture client only; no startup job or public route.
COPY --from=financial-ui /usr/local/bin/node /usr/local/bin/node
RUN install -d -m 0755 /usr/local/lib/bliss-ops
COPY --chmod=644 scripts/alpha-p0-fictional-creative-roundtrip.mjs /usr/local/lib/bliss-ops/alpha-p0-fictional-creative-roundtrip.mjs
RUN node --version && setpriv --reuid=app --regid=app --init-groups --no-new-privs sh -ec 'test -r /usr/local/lib/bliss-ops/alpha-p0-fictional-creative-roundtrip.mjs && node --check /usr/local/lib/bliss-ops/alpha-p0-fictional-creative-roundtrip.mjs'
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
COPY --chmod=755 scripts/railway-entrypoint.sh /usr/local/bin/bliss-railway-entrypoint
# Only the entrypoint initializes mount ownership as root; it immediately drops to app.
USER root
ENTRYPOINT ["/usr/local/bin/bliss-railway-entrypoint"]
